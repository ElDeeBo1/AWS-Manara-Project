# Copy this file to terraform.tfvars and edit the values.
aws_region   = "us-east-1"
project_name = "scalable-web"
environment  = "dev"

db_engine   = "mysql" # or "postgres"
alert_email = "you@example.com"

# Optional custom domain (needs a us-east-1 ACM certificate and a Route 53 hosted zone)
# domain_name         = "www.example.com"
# hosted_zone_id      = "Z0123456789ABCDEFGHIJ"
# acm_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/xxxxxxxx"
